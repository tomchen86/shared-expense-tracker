{
  "expo": {
    "name": "Shared Expense Tracker",
    "slug": "shared-expense-tracker",
    "scheme": "shared-expense-tracker",
    "userInterfaceStyle": "automatic",
    "ios": { "bundleIdentifier": "com.tomchen.sharedexpensetracker" },
    "android": { "package": "com.tomchen.sharedexpensetracker" },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        { "configureAndroidBackup": false, "faceIDPermission": false }
      ],
      "./plugins/android-backup-rules.cjs"
    ]
  }
}
