{
  "name": "shared-expense-tracker",
  "private": true,
  "packageManager": "pnpm@11.12.0",
  "engines": {
    "node": ">=22.22.1"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0 && node scripts/check-platform-boundaries.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "jest --runInBand",
    "test:traced": "jest --runInBand --coverage --testPathPattern=tests/acceptance/ --testNamePattern='(?<![A-Za-z0-9])[A-Z][A-Z0-9]*[-_][0-9]+[._][0-9]+(?![0-9])' --passWithNoTests"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-modules-commonjs": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.0.0",
    "babel-jest": "^29.7.0",
    "eslint": "10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "jest": "^29.7.0",
    "jest-junit": "17.0.0",
    "prettier": "^3.9.5",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.63.0"
  }
}
