{
  "name": "shared-expense-tracker",
  "private": true,
  "packageManager": "pnpm@11.28.9",
  "engines": {
    "node": ">=26.13.0"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0 && node scripts/check-platform-boundaries.cjs && node scripts/check-theme-colors.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "jest --maxWorkers=2",
    "test:mobile": "jest --maxWorkers=2 --ignoreProjects api",
    "test:traced": "jest --maxWorkers=2 --coverage --testPathPatterns=tests/acceptance/ --testNamePattern='(?<![A-Za-z0-9])[A-Z][A-Z0-9]*[-_][0-9]+[._][0-9]+(?![0-9])' --passWithNoTests"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-modules-commonjs": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.0.0",
    "babel-jest": "^30.5.2",
    "eslint": "10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "jest-junit": "17.0.0",
    "prettier": "^3.9.5",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1"
  }
}
